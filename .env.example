# Copy this file to .env.local and replace the URL and API key.
# To load .env instead, start with: AC_ENV_FILE=.env make run
# AuthCenter reads only the configcenter connection settings below.
# Store runtime settings in configcenter; see docs/configuration.md.

AC_CONFIGCENTER_URL=https://config.example.com
AC_CONFIGCENTER_API_KEY=cc_replace_with_authcenter_project_api_key
AC_CONFIGCENTER_ENVIRONMENT=production

# Optional credentials and network settings for local SCF deployment.
# These deployment settings are not bundled into the function package.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SCF_REGION=ap-guangzhou
SCF_VPC_ID=
SCF_SUBNET_ID=
